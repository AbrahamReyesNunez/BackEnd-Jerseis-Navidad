# =====================================================================
# Variables de entorno para PRODUCCIÓN (servidor del instituto).
# Copia este archivo como ".env" en el servidor y rellena los valores.
# El archivo .env NO se sube nunca a Git (está en .gitignore).
#
# Para generar claves aleatorias (en Linux):   openssl rand -base64 48
# =====================================================================

# Base de datos
DB_URL=jdbc:postgresql://localhost:5432/jerseys
DB_USUARIO=jerseys
DB_PASSWORD=

# Claves secretas (mínimo 32 caracteres, distintas entre sí)
JWT_SECRETO=
HASH_SECRETO=

# URL pública de la web (la que ve el usuario, con https y sin "/" al final).
# Va en los enlaces de los correos. El dominio principal (los otros redirigen a este):
URL_PUBLICA=https://elhiloquenosune.es

# Primer administrador (solo se usa si no existe ninguno)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Correo SMTP. OBLIGATORIO: sin él la aplicación no arranca (nadie podría activar su cuenta).
# Pasos para Gmail, Brevo o el correo del centro: GUIA.md, sección "Correo".
# Para comprobarlo, como admin: POST /api/admin/correo/prueba (te llega un correo).
MAIL_HOST=
MAIL_PORT=587
MAIL_USUARIO=
MAIL_PASSWORD=
# Vacío = se usa MAIL_USUARIO (en Gmail tiene que ser la misma cuenta)
MAIL_REMITENTE=
MAIL_NOMBRE_REMITENTE=El hilo que nos une
# Segundos entre correo y correo al avisar a todos (opcional; 2s = como mucho 1.800 por hora).
# Preguntad al responsable del correo del centro cuántos correos por hora deja mandar.
CORREO_PAUSA_MASIVOS=2s

# Fotos: en una carpeta del propio VPS, y el backend las sirve en /imagenes/.
# Esa carpeta tiene que ser un VOLUMEN de Docker, o se perderán al recrear el contenedor.
IMAGENES_ALMACEN=local
IMAGENES_DIRECTORIO=/datos/imagenes
# Solo si algún día las fotos van a otro servidor por FTP (IMAGENES_ALMACEN=ftp):
# FTP_HOST=
# FTP_PUERTO=21
# FTP_USUARIO=
# FTP_PASSWORD=
# FTP_DIRECTORIO=/imagenes
# FTP_FTPS=true

# Swagger (lista de la API en /swagger-ui.html). Apagado en producción.
SWAGGER_ACTIVADO=false

# CAPTCHA del registro (Cloudflare Turnstile). Clave SECRETA del panel de Cloudflare.
# La clave pública (sitekey) va en el HTML del front, no aquí.
CAPTCHA_ACTIVADO=true
TURNSTILE_SECRETO=

# Límite de peticiones por IP (opcional; si se dejan vacías se usan estos valores)
# login: por minuto | registro, reenvío del correo y "olvidé mi contraseña": cada 10 minutos
# Si en el instituto todos comparten IP y se bloquea a gente legítima, súbelos.
LIMITE_LOGIN=30
LIMITE_REGISTRO=30
LIMITE_REENVIAR=10
LIMITE_RECUPERAR=10
